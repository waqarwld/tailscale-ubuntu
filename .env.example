# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# It must be a NODE AUTH KEY (starts with tskey-auth-...), not an API access token.
TS_AUTHKEY=
# Optional: pick the node name shown in your tailnet
TS_HOSTNAME=ubuntu-node
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
DISCORD_SUPPORT_ROLE_ID=
TICKET_START_NUMBER=1000
MAX_MESSAGE_LENGTH=1900
